{
  "extends": "@ranki/config-typescript/tsconfig.plugin.component.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "types",
    "paths": {
      "@dqm/package-dqm-api-v2": ["../../packages/dqm-api-v2/*"],
      "@dqm/package-dqm-utils": ["../../packages/plugin-utils/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../../packages/dqm-api-v2"
    },
    {
      "path": "../../packages/plugin-utils"
    }
  ]
}

Ranki  {
  Document (Sections need to be separated by two new lines)
    = ListOf<Section, nl2>
  
  space := " " | "\t"
  nl = "\n" | "\r"
  nl2 = nl nl
  c = ","
  s = ";"
  a = "="
  dir = "%%%"
  fr = ":::"
  
  sep<char, ln>
    = char? ln --multi
    | char --single
  
  Section = Directive | Block
  
  Block = Frame_block | Paragraph
  
  Free = (~(fr | dir) any)+
  Line =  (~(fr | dir | nl) any)+
  Inline = Frame_inline | Line 
  
  FrameAttrs = (sep<c, nl> ListOf<Param, sep<c, nl>>)
  FrameParams = ListOf<Param, sep<c, nl>>
  FrameSep = sep<s, nl2>
  FrameType = letter+
  FrameContent = ListOf<Block, (nl2 | end)>
  FrameSpec
    = FrameType FrameAttrs? FrameSep FrameParams FrameSep FrameContent --three
    | FrameType FrameAttrs? FrameSep FrameContent                      --two
    | FrameType FrameAttrs? nl*                                        --one
  Frame_inline = Wrap_inline<fr, FrameSpec>
  Frame_block = Wrap_block<fr, FrameSpec>
    
  Paragraph = ListOf<Inline, (nl | end)>
  
  DirectiveAttrs = ListOf<Param, sep<c, nl>>
  DirectiveSep = sep<s, (nl2 | end)>
  DirectiveSpec = DirectiveAttrs DirectiveSep ListOf<Block, nl>
  Directive = Wrap<dir, DirectiveSpec>
  
  Wrap<tag, spec> 
    = tag nl spec nl (tag | end) --block
    | tag spec (tag | end) --inline
    
  Param
    = letter+ a alnum+ --kwarg
    | letter+ --arg
}

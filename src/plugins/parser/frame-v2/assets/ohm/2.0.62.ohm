RankiFrameV2 <: RankiParamsV2 {
  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2
    | ...

  paramValueItem :=
    | v2 --v2
    | ...
  
  pauseDocument = whitespace pauseList whitespace
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*

  v2PayloadPlain =  (~pauseStart ~directive ~v2End any)+
  
  // I'm not sure if this is a good idea. it does isolate nested frame errors though
//  v2Malformed = directive (~frame any)* frame (~(frame directive) any)+ frame ("-"? digit+)? directive
  
  v2PayloadSectionItem = 
    | v2 --v2
    | v2PayloadPlain --plain
  
  v2PayloadSection = v2PayloadSectionItem (whitespace v2PayloadSectionItem)*

  pauseStart = pause digit* pause
  pauseEnd = pause pause
  pausedContainer = whitespace pauseStart pausedPayload pauseEnd whitespace

  // !FIX this would break with nested pauses
  pausedPayload = (~pauseEnd ~v2End any)+
  
  v2Type = letter+ (clearance letter+)* 
  
  v2Payload = 
    | wi nl pauseDocument --P
    | pauseDocument --p

  v2End =
    | frame "-"? digit+ directive --exact
    | frame directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2ParamListBlock whitespace --D  
    | wi v2ParamListInline wi --d  
  
  v2FrameConfigFp =
    | wi 
        v2Type wi 
          v2ParamListBlockContainer wi
          sepRight?  --F
    |   wi 
      v2Type wi 
        v2ParamListInlineContainer wi 
        sepRight?  --f

  v2FrameConfigP = wi v2Type wi (sepRight | nl)

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | directive v2DirectiveConfig frame v2FrameConfig v2Payload v2End --dfp
    | directive frame v2FrameConfig v2Payload v2End --fp
    | directive frame wi v2Type wi v2End --e 
}

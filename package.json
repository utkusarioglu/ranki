{
  "name": "@ranki/root",
  "private": true,
  "workspaces": [
    "src/config/*",
    "src/apps/*",
    "src/legacy/*",
    "src/packages/*",
    "src/plugins/*"
  ],
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "build": "turbo run build",
    "watch": "turbo run watch",
    "dev--v2-demo": "turbo run dev --filter @ranki/app-rankilang-v2-demo",
    "console--v2": "cd src/apps/dqm-v2-console && yarn console",
    "lint": "turbo run lint",
    "clean-all": "rm -rf .turbo && yarn turbo run clean-all",
    "knip": "knip",
    "clean-anki": "scripts/anki/clean-anki.sh",
    "copy-to-anki": "scripts/anki/copy-to-anki.js"
  },
  "devDependencies": {
    "@ranki/config-typescript": "workspace:^",
    "@types/node": "^25.5.0",
    "knip": "^6.1.1",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^6.0.2"
  }
}

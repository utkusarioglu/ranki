RankiParamsV2 <: RankiBase {
  v2ParamListBlockContainer = sepLeft wi 
          nl wi 
        v2paramListBlock wi 
          sepLeft?
  
  v2ParamListInlineContainer = sepLeft wi 
      v2paramListInline wi 
        sepLeft?
        
  v2SepLeftInline = wi sepLeft wi
  v2SepLeftBlock = wi sepLeft? wi nl wi
  v2paramListInline = param (v2SepLeftInline param)*
  v2paramListBlock = param (v2SepLeftBlock param)*

  param =
    | paramKey wi assignment wi paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive

  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValue = paramValueItem (spaces paramValueItem)*

  paramValueItem = 
    | quoted<quoteSingle>
    | quoted<quoteDouble>
    | paramValueItemPrimitive
    
  quoted<q> = q quotedContent<q>* q
  quotedContent<q> = 
    | "\\" q --escaped
    | ~q any --content

  paramValueItemPrimitive =
    | number --number
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
}

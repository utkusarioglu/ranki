// 2.0.59
RankiConfig {
  root = ""

  //v1
  frameV1 = ":::"
  
  // v2
  pause = ","
  directive = "%"
  frame = ":"
  
  // params
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  negation = "!"

  // line alteration tokens
  align = "$"
  h = "#"
  small = "_"
  
  // text decoration tokens
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"

  // language tokens
  esc = "\\"
  sentence = "." | "!" | "?"

  divider = "~"
  
  // number tokens
  complexUnits = "i" | "j" | "k"
}

RankiBase <: RankiConfig {
  root := 
    | indentation directive clearance "ignore" wm any* --ignore
    | whitespace structure whitespace --structure

  structure = section --base
    // | indentation directive clearance "ignore" wm any* --ignore
    
  // sections = section (sectionSep section)* 
  // sectionSep = nl wi nl wi (nl wi)+ --threeLines
    
  section =  
    | block (blockSep block)* --base
    | "" --empty
    
  blockSep = nl wi (nl wi)+ --base
  
  block  = 
    | p --p
  
  p = line (nl line)*
  
  line = indentation lineModifiers lexemes wi
  lineModifiers  = ""
    
  lexemes = lexeme (clearance lexeme)*
  
  lexeme = decorated

  decorated = 
    | word &wordEnd --base
    | hChar<~(nl | space) any>+ &wordEnd --fallback
 
  word = 
    | number --number
    | hChar<~(nl | space | end) any>+ --base
  
  number (Number) = 
    | digit+ --digits
  
  wordEnd =  clearance | nl | end

  hWord<t> = t &wordEnd
  
  hCheck<t> = &t t
  
  quoteSingle =
    | "'" --open
    | "'" --close
    
  quoteDouble =
    | "\"" --open
    | "\"" --close

  bracketRound = 
    | "(" --open
    | ")" --close
  
  bracketSquare =
    | "[" --open
    | "]" --close
  
  bracketCurly = 
    | "{" --open
    | "}" --close
    
  quotes = 
    | quoteSingle --single
    | quoteDouble --double
    
  brackets = 
    | bracketRound --round
    | bracketSquare --square
    | bracketCurly --curly

  wordToken = ""
  lineToken = ""

  hChar<c> = 
    | esc wordToken --escaped
    | esc c --redundant
    | c --regular
    
  indentation = spaces
  clearance = space+
  
  wm (waste multiline) 
    = spaces nl
    
  wi (waste inline) 
    = spaces
    
  whitespace = wm* wi
  
  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiFrameV1 <: RankiBase {
  word :=
    | v1Inline
    | ...
  
  block := 
    | indentation v1Block  wi &(nl | end) --v1
    | ...
  
  v1SepLeftInline = wi sepLeft wi
  v1SepLeftBlock = wi sepLeft? wi nl wi
  
  v1ParamValue = (~(space | frameV1 | sepRight | nl) any)+
  v1ParamListInline = v1ParamValue (v1SepLeftInline v1ParamValue)*
  
  v1Type = letter (space | letter)*
  
  v1Inline = 
    | frameV1 wi 
        v1Type wi 
          sepRight wi 
        v1ParamListInline wi 
          sepRight 
        v1PayloadInline 
      frameV1 --fp
    | frameV1 wi 
        v1Type wi 
          sepRight 
        v1PayloadInline 
      frameV1 --p

  v1PayloadInline = (~(frameV1 | nl) any)*
  
  // not sure about this one
  v1BlockEnd = 
    | frameV1 ~(wi v1Type) --explicit
    | end --implicit

  v1Block = 
    | frameV1 wi 
         v1Type wi
         sepRight wi
         v1ParamListInline wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       v1BlockEnd --fp
    | frameV1 wi 
         v1Type wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       v1BlockEnd --p

  v1PayloadBlockPlain = (~v1Inline any)+
  v1PayloadBlock = (v1Inline | v1PayloadBlockPlain )*
}

RankiParamsV2 <: RankiBase {
  v2ParamListBlockContainer = sepLeft wi 
          nl wi 
        v2paramListBlock wi 
          sepLeft?
  
  v2ParamListInlineContainer = sepLeft wi 
      v2paramListInline wi 
        sepLeft?
        
  v2SepLeftInline = wi sepLeft wi
  v2SepLeftBlock = wi sepLeft? wi nl wi
  v2paramListInline = param (v2SepLeftInline param)*
  v2paramListBlock = param (v2SepLeftBlock param)*

  param =
    | paramKey wi assignment wi paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive

  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValue = paramValueItem (spaces paramValueItem)*

  paramValueItem = 
    | quoted<quoteSingle>
    | quoted<quoteDouble>
    | paramValueItemPrimitive
    
  quoted<q> = q quotedContent<q>* q
  quotedContent<q> = 
    | "\\" q --escaped
    | ~q any --content

  paramValueItemPrimitive =
    | number --number
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
}

RankiRichNumber <: RankiBase {
  integer (Integer) = 
    | "-"? digit+  --signed
    | digit+ --unsigned
    
  decimal (Decimal number) = 
    | "-"? digit* "." digit+ --signed
    | digit* "." digit+ --unsigned
    
  eNotation (Base 10 scientific notation) = "-"? digit* ("." digit+)? "e" integer
  
  hComplex<real, imaginary> = 
   | real clearance ("+" | "-") clearance imaginary complexUnits --bi
   | real clearance ("+" | "-") clearance complexUnits imaginary --ib
    
 complex (Complex Number) = hComplex<scalar, scalar>

 scalar (Scalar Number)= 
    | eNotation --eNotation
    | decimal --decimal
    | integer --integer

  number := 
    | complex --complex
    | scalar --scalar
    | ...
    
  word :=
    | number
    | ...
}

RankiRichText <: RankiBase {
  lineModifiers := alignment smalltext heading

  smalltext =
    | &(small+ ~clearance) --decoration
    | small+ clearance --small
    | ~small --normal

  heading (Line heading level qualifier) = 
    | &(h+ ~clearance) --decoration
    | h+ clearance --heading
    | ~h --normal
    
  alignment (Line alignment qualifier) =
    | &(align+ ~clearance) --decoration
    | ~align --unaligned
    | align+ clearance --aligned

  lexeme := 
    | textual --textual
    | ...

  textual = decorated (clearance decorated)*

  decorated := 
//    | word &wordEnd --bare
    | hChar<inWordToken>* word hChar<inWordToken>* &wordEnd--decorated
    | hChar<inWordToken>+ &wordEnd --token
    | hChar<inWordToken>* hChar<~wordEnd ~inWordToken any>+ hChar<inWordToken>* &wordEnd--richTextBase
    | ...

  word :=
    | text --chars
//    | hChar<digit>+ --digits
    | hChar<punctuation>+ --punctuation
//    | hChar<(letter | digit | punctuation)>+ --mixed
    | ...

  text (Text Word) =
    | hChar<upper> hChar<lower>+ --proper
    | hChar<upper>+ --uppercase
    | hChar<lower>+ --lowercase
    | hChar<letter>+ --mixedcase

  inWordToken = wordToken | sentence | lineToken | esc ~lineToken

  punctuation (Punctuation mark) = 
    ~(alnum | space | nl | digit | inWordToken) any

  // they come at the start of lines to alter their behavior
  lineToken := align | h | small
  
  // they come at the beginning or end of words to alter their behavior
  wordToken := 
    | em --emphasis
    | b --bold
    | i --idiomatic
    | u --underlined
    | abbr --abbreviation
    | quotes
    | brackets
}

RankiFrameV2 <: RankiParamsV2 {
  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2
    | ...

  paramValueItem :=
    | v2 --v2
    | ...
  
  pauseDocument = whitespace pauseList whitespace
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*

  v2PayloadPlain =  (~pauseStart ~directive ~v2End any)+
  
  // I'm not sure if this is a good idea. it does isolate nested frame errors though
//  v2Malformed = directive (~frame any)* frame (~(frame directive) any)+ frame ("-"? digit+)? directive
  
  v2PayloadSection = 
    | ((v2 | v2PayloadPlain) whitespace)* 

  pauseStart = pause digit* pause
  pauseEnd = pause pause
  pausedContainer = whitespace pauseStart whitespace pausedPayload whitespace pauseEnd whitespace
  pausedPayload = (~pauseEnd ~v2End any)+
  
  v2Type = letter (space | letter)*
  
  v2Payload = 
    | wi nl pauseDocument --P
    | pauseDocument --p

   v2End =
    | frame "-"? digit+ directive --exact
    | frame directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2paramListBlock whitespace --D  
    | wi v2paramListInline wi --d  
  
  v2FrameConfigFp =
    | wi 
        v2Type wi 
          v2ParamListBlockContainer wi
          sepRight?  --F
    |   wi 
      v2Type wi 
        v2ParamListInlineContainer wi 
        sepRight?  --f

  v2FrameConfigP = wi v2Type wi (sepRight | nl)

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | directive v2DirectiveConfig frame v2FrameConfig v2Payload v2End --dfp
    | directive frame v2FrameConfig v2Payload v2End --fp
    | directive frame wi v2Type wi v2End --e 
}

RankiMath <: RankiRichNumber {
  trigonometry = 
    | "a"? "sin" "h"?
    | "a"? "cos" "h"?
    | "a"? "tan" "h"?
    
  functionName =
    trigonometry
    
  symbolicMath =
    | functionName space letter+ --trigonometry
    
  numericMath = 
    | functionName space number --trigonometry
  
  math = 
    | symbolicMath --symbolic
    | numericMath --numeric
    | commonEquations
    
  commonEquations =
    | letter "x" digit space ("+" | "-") space letter "x" space ("+" | "-") space letter --quadratic

  lexeme :=
    | math
    | ...
}

// collection, volume, chapter, article, section, block
RankiRichStructure <: RankiParamsV2 {
  structure := richStructure

  blockSep := nl wi nl wi --richStructure

  richStructure = hLevel<caseInsensitive<"collection">, collection>

  collection = hLevel<caseInsensitive<"volume">, volume>

  volume = hLevel<caseInsensitive<"chapter">, chapter>

  chapter = hLevel<caseInsensitive<"article">, article>

  article = hLevel<caseInsensitive<"section">, section>

  structureSepStart = blockSep (nl wi)+ divider+ 
  structureSepEnd = divider+ nl (wi nl)* wi

  hStructureSepInline<structureName> =
    | structureSepStart wi 
        structureName wi 
      structureSepEnd --s
    | structureSepStart wi 
        structureName wi 
        v2ParamListInlineContainer wi 
      structureSepEnd --sp
  
  hStructureSepBlock<structureName> = 
    | structureSepStart wi 
          nl wi 
        structureName wi 
          nl wi 
      structureSepEnd --S
    | structureSepStart wi 
          nl wi 
        structureName wi 
        v2ParamListBlockContainer wi 
          nl wi
      structureSepEnd --SP

  hStructureSep<structureName> = 
    | hStructureSepBlock<structureName> --block
    | hStructureSepInline<structureName> --inline

  hLevel<structureName, structureType> =
    | structureType (hStructureSep<structureName> structureType)* --defined
    | "" --empty
}


RankiConfig {
  negation = "!"
  sep_parameter = ","
  sep_argument = ";"
  assignment = "="
  quote_single = "\""
  quote_double = "'"
  directive = "%%%"
  frame = ":::"
  pause = "---"
  h = "#"
  em = "/"
  b = "*"
  i = "_"
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiRoot <: RankiConfig {
  document = whitespace documentList<documentType, nl+> whitespace
  documentList<type, sep> = type? (sep type)*
  documentType =  dirBlock | frBlock | p
  
  // Param
  param  = paramKey
  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  
  // Params
  paramList = param (paramSep param)*
  paramSep 
    = wi sep_parameter? wi nl wi --multiline
    | wi sep_parameter wi --inline
  
  // directive
  dirBlock
    = directive wi wm+ 
         dirArgs 
         argSep 
         dirPayload 
       (directive | end)
    
   // unused rn
  dirInline = directive wi dirArgs sep_argument dirPayload directive --inline
    
  dirArgs = paramList
  // dirPayload = (~directive any)*
  dirPayload = document
  
  // Args
  argSep 
    = wi sep_argument? nl wi nl --multiline
    | wi sep_argument wi --inline
    
  // unused rn
  frInline
    = frame wi 
         frType wi 
           sep_parameter wi 
         frArgs wi 
           sep_argument 
         frParams wi
           sep_argument
         frPayload 
       frame --ap
    | frame wi 
         frType wi 
           sep_parameter wi 
         frArgs wi 
           sep_argument 
         frParams wi
           sep_argument
         frPayload 
       frame --p
    | frame wi 
        frType wi 
          sep_parameter wi 
        frArgs wi 
          sep_argument 
        frPayload 
      frame --a
    | frame wi 
        frType wi 
          sep_argument 
        frPayload 
      frame --n
    | frame wi 
        frType wi 
      frame --e
    
  frBlock
    = frame wi 
         frType wi 
           sep_parameter? wi 
           nl wi
         frArgs wi 
           (sep_argument | nl) wi 
           whitespace
         frParams wi
           (sep_argument | nl) wi
           nl wi
         frPayload 
       (frame | end) --ap
    | frame wi 
         frType wi 
           sep_parameter? wi 
           nl wi
         frParams wi
           (sep_argument | nl) wi
           nl wi
         frPayload 
       (frame | end) --p
    | frame wi 
         frType wi 
           sep_argument wi 
           nl wi
         frArgs wi 
           (sep_argument | nl) wi 
           nl wi
         frPayload 
       (frame | end) --a
    | frame wi 
         frType wi 
           sep_argument? wi 
           nl wi
         frPayload 
       (frame | end) --n
     
  frType = letter (space | letter)*
  frArgs = paramList
  frParams = paramList
  frPayload = document
    
  p = pLine (nl pLine)*
  pStyle
    = em pLine em --emphasis
    | b pLine b --bold
    | i pLine i --idiomatic
    | pText --unstyled
  pLine = pStyle (clearance pStyle)*
  pText = pWord (clearance pWord)*
  pWord = (~pIllegal any)*
  pIllegal = frame | directive | nl | space
  
  indentation = spaces
  wi (waste inline) 
    = spaces
  wm (waste multiline) 
    = spaces nl
  clearance = space+
  whitespace = wm* wi
}

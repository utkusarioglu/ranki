// 2.0.61
RankiConfig {
  root = ""

  //v1
  frameV1 = ":::"
  
  // v2
  pause = ","
  directive = "%"
  frame = ":"
  
  // params
  sepLeft = ","
  sepRight = ";"
  assign = "="
  append = "+="
  remove = "-=" 
  negation = "!"

  // line alteration tokens
  align = "$"
  h = "#"
  small = "_"
  
  // text decoration tokens
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"

  // language tokens
  esc = "\\"
  sentence = "." | "!" | "?"

  // Rich structure tokens
  divider = "~"
  
  // number tokens
  complexToken = "i" | "j" | "k"
  infinityToken = "inf"
  piToken = "pi" | "PI"
  eToken = "e" | "E"
  hexadecimalToken = "x" | "X"
  octalToken = "o" | "O"
  binaryToken = "b" | "B"
  decimalToken = "."
  negativeToken = "-"
  positiveToken = "+"
  groupToken = "_"
  rationalToken = "/"
}

RankiBase <: RankiConfig {
  root := 
    | indentation directive clearance "ignore" wm any* --ignore
    | whitespace structure whitespace --structure

  structure = section --base

  section =  
    | block (blockSep block)* --base
    | "" --empty
    
  blockSep = nl wi (nl wi)+ --base
  
  block  = 
    | p --p
  
  p = line (nl line)*
  
  line = indentation lineModifiers lexemes wi
  lineModifiers  = ""
    
  lexemes = lexeme (clearance lexeme)*
  
  lexeme = 
    | decorated --decorated

  decorated = 
    | word &wordEnd --base
    | hChar<~(nl | space) any>+ &wordEnd --fallback
 
  word = 
    | number --number
    | hChar<~(nl | space | end) any>+ --base
  
  number (Number) = 
    | digit+ --digits
  
  wordEnd =  clearance | nl | end

  hWord<t> = t &wordEnd
  
  hCheck<t> = &t t
  
  quoteSingle =
    | "'" --open
    | "'" --close
    
  quoteDouble =
    | "\"" --open
    | "\"" --close

  bracketRound = 
    | "(" --open
    | ")" --close
  
  bracketSquare =
    | "[" --open
    | "]" --close
  
  bracketCurly = 
    | "{" --open
    | "}" --close
    
  quotes = 
    | quoteSingle --single
    | quoteDouble --double
    
  brackets = 
    | bracketRound --round
    | bracketSquare --square
    | bracketCurly --curly

  wordToken = ""
  lineToken = ""

  hChar<c> = 
    | esc wordToken --escaped
    | esc c --redundant
    | c --regular
    
  indentation = spaces
  clearance = space+
  
  wm (waste multiline) 
    = spaces nl
    
  wi (waste inline) 
    = spaces
    
  whitespace = wm* wi
  
  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiFrameV1 <: RankiBase {
  word :=
    | v1Inline
    | ...
  
  block := 
    | indentation v1Block  wi &(nl | end) --v1
    | ...
  
  v1SepLeftInline = wi sepLeft wi
  v1SepLeftBlock = wi sepLeft? wi nl wi
  
  v1ParamValue = (~(space | frameV1 | sepRight | sepLeft | nl) any)+
  v1ParamListInline = v1ParamValue (v1SepLeftInline v1ParamValue)*
  
  v1Type = letter (space | letter)*
  
  v1Inline = 
    | frameV1 wi 
        v1Type wi 
          sepRight wi 
        v1ParamListInline wi 
          sepRight 
        v1PayloadInline 
      frameV1 --fp
    | frameV1 wi 
        v1Type wi 
          sepRight 
        v1PayloadInline 
      frameV1 --p

  v1PayloadInline = (~(frameV1 | nl) any)*
  
  // not sure about this one
  v1BlockEnd = 
    | frameV1 ~(wi v1Type) --explicit
    | end --implicit

  v1Block = 
    | frameV1 wi 
         v1Type wi
         sepRight wi
         v1ParamListInline wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       v1BlockEnd --fp
    | frameV1 wi 
         v1Type wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       v1BlockEnd --p

  v1PayloadBlockPlain = (~(v1Inline | v1BlockEnd) any)+
  v1PayloadBlock = (v1Inline | v1PayloadBlockPlain )*
}

RankiParamsV2 <: RankiBase {
  v2ParamListBlockContainer = sepLeft wi 
          nl wi 
        v2ParamListBlock wi 
          sepLeft?
  
  v2ParamListInlineContainer = sepLeft wi 
      v2ParamListInline wi 
        sepLeft?
        
  v2SepLeftInline = wi sepLeft wi
  v2SepLeftBlock = wi sepLeft? wi nl wi
  v2ParamListInline = param (v2SepLeftInline param)*
  v2ParamListBlock = param (v2SepLeftBlock param)*

  operator =
    | remove
    | append
    | assign

  param =
    | paramKey wi operator wi paramValues --operator
    | negation paramKey --negative
    | paramKey --positive

  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValues = paramValueItem (clearance paramValueItem)*

  paramValueItem = 
    | quoted<quoteSingle>
    | quoted<quoteDouble>
    | paramValueItemPrimitive
    
  quoted<q> = q quotedContent<q>* q
  quotedContent<q> = 
    | esc q --escaped
    | ~q any --content

  paramValueItemPrimitive =
    | number --number
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
}

RankiRichNumber <: RankiBase {
  groupedDigits3 =
    | digit digit digit --three
    | groupedDigits2

  groupedDigits2 =
    | digit digit --two
    | digit --one

  numberSystemInternational = groupedDigits3 (groupToken groupedDigits3_three)+
  numberSystemIndian = groupedDigits2 groupToken (groupedDigits2_two groupToken)+ groupedDigits3_three --lakhCrore

  numberSystem = 
    | numberSystemIndian --indian
    | numberSystemInternational --international
    | digit+ --basic

  integer (Integer) = 
    | negativeToken numberSystem --negative
    | positiveToken numberSystem --positive
    | numberSystem --unsigned
    
  decimal (Decimal number) = 
    | integer decimalToken integer_unsigned --full
    | decimalToken integer_unsigned --point
    
  eNotation (Base 10 scientific notation) = scalar eToken integer
    
  complex (Complex Number) = 
   | scalar clearance ("+" | "-") clearance scalar complexToken --si
   | scalar clearance ("+" | "-") clearance complexToken scalar --is
   | scalar clearance ("+" | "-") clearance complexToken --i

  scalar (Scalar Number) =
    | decimal
    | integer

  rational = number rationalToken number

  hConcept<token> =
    | negativeToken token --negative
    | positiveToken token --positive
    | token --unsigned
  
  conceptualSymbol = 
    | hConcept<infinityToken> --infinity
    | hConcept<eToken> --e
    | hConcept<piToken> --pi

  conceptual = digit+ conceptualSymbol

  hBasicGroup<range> = range (groupToken? range)*
  hZeroTypePositive<symbol, range> =  "0" symbol hBasicGroup<range>
  hZeroType<symbol, range> = 
    | negativeToken hZeroTypePositive<symbol, range> --negative
    | hZeroTypePositive<symbol, range> --positive

  octal = hZeroType<octalToken, ("0".."7")>
  binary = hZeroType<binaryToken, ("0" | "1")>
  hexadecimal = hZeroType<hexadecimalToken, ("0".."9" | "a".."f" | "A".."F")>

  bases = 
    | hexadecimal
    | binary
    | octal

  number := 
    | bases
    | conceptual
    | rational
    | complex 
    | eNotation 
    | scalar 
    | ...
    
  word :=
    | number
    | ...
}

RankiRichText <: RankiBase {
  lineModifiers := alignment smalltext heading

  smalltext =
    | &(small+ ~clearance) --decoration
    | small+ clearance --small
    | ~small --normal

  heading (Line heading level qualifier) = 
    | &(h+ ~clearance) --decoration
    | h+ clearance --heading
    | ~h --normal
    
  alignment (Line alignment qualifier) =
    | &(align+ ~clearance) --decoration
    | ~align --unaligned
    | align+ clearance --aligned

  lexeme := 
    | textual --textual
    | ...

  textual = decorated (clearance decorated)*

  decorated := 
//    | word &wordEnd --bare
    | hChar<inWordToken>* word hChar<inWordToken>* &wordEnd --decorated
    | hChar<inWordToken>+ &wordEnd --token
    | hChar<inWordToken>* hChar<~wordEnd ~inWordToken any>+ hChar<inWordToken>* &wordEnd --richTextBase
    | ...

  word :=
    | text --chars
//    | hChar<digit>+ --digits
    | hChar<punctuation>+ --punctuation
    // | hChar<~wordEnd ~inWordToken any>+ --richTextBase
//    | hChar<(letter | digit | punctuation)>+ --mixed
    | ...

  text (Text Word) =
    | hChar<upper>+ hChar<lower>+ (hChar<upper>+ hChar<lower>*)+ --mixedcaseUl
    | hChar<upper> hChar<lower>+ --propercase
    | hChar<upper>+ --uppercase
    | hChar<lower>+ (hChar<upper>+ hChar<lower>*)+ --mixedcaseLu
    | hChar<lower>+ --lowercase

  inWordToken = wordToken | sentence | lineToken | esc ~lineToken

  punctuation (Punctuation mark) = 
    ~(alnum | space | nl | digit | inWordToken) any

  // they come at the start of lines to alter their behavior
  lineToken := align | h | small
  
  // they come at the beginning or end of words to alter their behavior
  wordToken := 
    | em --emphasis
    | b --bold
    | i --idiomatic
    | u --underlined
    | abbr --abbreviation
    | quotes
    | brackets
}

RankiFrameV2 <: RankiParamsV2 {
  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2
    | ...

  paramValueItem :=
    | v2 --v2
    | ...
  
  pauseDocument = whitespace pauseList whitespace
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*

  v2PayloadPlain =  (~pauseStart ~directive ~v2End any)+
  
  // I'm not sure if this is a good idea. it does isolate nested frame errors though
//  v2Malformed = directive (~frame any)* frame (~(frame directive) any)+ frame ("-"? digit+)? directive
  
  v2PayloadSectionItem = 
    | v2 --v2
    | v2PayloadPlain --plain
  
  v2PayloadSection = v2PayloadSectionItem (whitespace v2PayloadSectionItem)*

  pauseStart = pause digit* pause
  pauseEnd = pause pause
  pausedContainer = whitespace pauseStart pausedPayload pauseEnd whitespace

  // !FIX this would break with nested pauses
  pausedPayload = (~pauseEnd ~v2End any)+
  
  v2Type = letter+ (clearance letter+)* 
  
  v2Payload = 
    | wi nl pauseDocument --P
    | pauseDocument --p

  v2End =
    | frame "-"? digit+ directive --exact
    | frame directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2ParamListBlock whitespace --D  
    | wi v2ParamListInline wi --d  
  
  v2FrameConfigFp =
    | wi 
        v2Type wi 
          v2ParamListBlockContainer wi
          sepRight?  --F
    |   wi 
      v2Type wi 
        v2ParamListInlineContainer wi 
        sepRight?  --f

  v2FrameConfigP = wi v2Type wi (sepRight | nl)

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | directive v2DirectiveConfig frame v2FrameConfig v2Payload v2End --dfp
    | directive frame v2FrameConfig v2Payload v2End --fp
    | directive frame wi v2Type wi v2End --e 
}

RankiMath <: RankiRichNumber {
  trigonometry = 
    | "a"? "sin" "h"?
    | "a"? "cos" "h"?
    | "a"? "tan" "h"?
    
  functionName =
    trigonometry
    
  symbolicMath =
    | functionName space letter+ --trigonometry
    
  numericMath = 
    | functionName space number --trigonometry
  
  math = 
    | symbolicMath --symbolic
    | numericMath --numeric
    | commonEquations
    
  commonEquations =
    | letter "x" digit space ("+" | "-") space letter "x" space ("+" | "-") space letter --quadratic

  lexeme :=
    | math
    | ...
}

// collection, volume, chapter, article, section, block
RankiRichStructure <: RankiParamsV2 {
  structure := richStructure

  blockSep := nl wi nl wi --richStructure

  richStructure = hLevel<caseInsensitive<"collection">, collection>

  collection = hLevel<caseInsensitive<"volume">, volume>

  volume = hLevel<caseInsensitive<"chapter">, chapter>

  chapter = hLevel<caseInsensitive<"article">, article>

  article = hLevel<caseInsensitive<"section">, section>

  structureSepStart = blockSep (nl wi)+ divider+ 
  structureSepEnd = divider+ nl (wi nl)* wi

  hStructureSepInline<structureName> =
    | structureSepStart wi 
        structureName wi 
      structureSepEnd --s
    | structureSepStart wi 
        structureName wi 
        v2ParamListInlineContainer wi 
      structureSepEnd --sp
  
  hStructureSepBlock<structureName> = 
    | structureSepStart wi 
          nl wi 
        structureName wi 
          nl wi 
      structureSepEnd --S
    | structureSepStart wi 
          nl wi 
        structureName wi 
        v2ParamListBlockContainer wi 
          nl wi
      structureSepEnd --SP

  hStructureSep<structureName> = 
    | hStructureSepBlock<structureName> --block
    | hStructureSepInline<structureName> --inline

  hLevel<structureName, structureType> =
    | structureType (hStructureSep<structureName> structureType)* --defined
    | "" --empty
}


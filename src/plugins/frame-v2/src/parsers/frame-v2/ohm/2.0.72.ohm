RankiFrameV2 <: RankiParamsV2 {
  rootBlock := ...

  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2 --v2
    | ...

  paramValueItem :=
    | v2 --v2
    | ...
  
  // pauseRoot = pauseList
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*

  v2PayloadPlainIllegal = 
    | pauseStart 
    | v2Start 
    | v2End_explicit 
    // | v2End_exact
  
  // This is what inline pauses target
  // frameV2LineRoot = lexemes

  // v2PayloadPlain =  (~v2PayloadPlainIllegal any)+
  v2PayloadPlain =  
    | v2Start (~v2End any)* v2End --failedFrameV2
    | (~v2PayloadPlainIllegal any)+ --fallback
  
  v2PayloadSectionItem = 
    | v2 whitespace
    | v2PayloadPlain whitespace
  
  // v2PayloadSection = v2PayloadSectionItem (whitespace v2PayloadSectionItem)* whitespace
  v2PayloadSection = v2PayloadSectionItem+

  pauseStart = tFrameV2Pause digit* tFrameV2Pause
  pauseEnd = tFrameV2Pause tFrameV2Pause
  pausedContainer =
    | wm pauseStart pausedPayload pauseEnd --P
    | pauseStart pausedPayload pauseEnd --p

  // !FIX this would break with nested pauses
  pausedPayload = (~(pauseEnd | v2End) any)+
  
  v2ChainList = paramKey (clearance paramKey)*
  
  v2Payload = 
    | wm pauseList --P
    | pauseList --p

  v2End =
    | tFrameV2RightOuter "-"? digit+ --exact
    |  tFrameV2RightOuter --explicit
    | end --implicit

  v2Start = tFrameV2LeftOuter
  
  v2FrameConfigFp =
    |   wi 
      v2ChainList wi 
      v2ParamListBlockContainer wi
        tFrameV2SeparatorParam?  --F
    |   wi 
      v2ChainList wi 
      v2ParamListInlineContainer wi 
        tFrameV2SeparatorParam? --f

  v2FrameConfigP = wi v2ChainList wi (tFrameV2SeparatorParam | &nl)

  v2FrameConfigE = wi v2ChainList wi

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p
    | v2FrameConfigE --e

  v2 = 
    | v2Start v2FrameConfig v2Payload v2End --fp
    | v2Start v2FrameConfig v2End --f
}

{
  "name": "@dqm/plugin-static-render-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "watch": "concurrently -n 'ParamsV2' -c yellow,cyan \"tsc --watch --preserveWatchOutput\" \"vite build --watch\"",
    "clean-all": "rm -rf .turbo lib dist types node_modules tsconfig.tsbuildinfo && rm -rf vite*timestamp-* || true"
  },
  "dependencies": {
    "@dqm/package-plugin-utils": "workspace:^",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@dqm/package-dqm-api-v2": "workspace:^",
    "@ranki/config-typescript": "workspace:^",
    "@ranki/package-anki-ui": "workspace:^",
    "@types/node": "^25.0.6",
    "@types/prismjs": "^1",
    "@types/qrcode": "^1",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "vite": "^7.2.2"
  },
  "exports": {
    ".": {
      "types": "./types/export.d.mts",
      "default": "./lib/_ranki2_plugin_sre.js"
    }
  }
}

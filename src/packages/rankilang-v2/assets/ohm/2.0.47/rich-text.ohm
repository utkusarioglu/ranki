RankiText <: RankiBasic {
  document := 
    | ... 
    | whitespace documentList whitespace --blocks
    
  line := indentation alignment heading lineContent (clearance lineContent)* wi

  heading (Line heading level qualifier) = 
    | small+ clearance --small
    | h+ clearance --heading
    | ~h --text
    
  alignment (Line alignment qualifier) =
    | align+ clearance --aligned
    | ~align --unaligned

  lineContent = |
    textual --textual

  textual = 
    | sentence sentenceSep (clearance sentence sentenceSep)* --proper
    | sentence --rude
      
  sentence = decorated<""> (clearance decorated<"">)*
  
  hDecoration<s, c, e> = s c e

  decorated<e> =
    | hDecoration<em, decorated<e>, em> --emphasis
    | hDecoration<b, decorated<e>, b> --bold
  //  | hDecoration<i, decorated<e>, i> --idiomatic
 //   | hDecoration<u, decorated<e>, u > --underline
//    | hDecoration<"(", decorated<e>, ")"> --parens1
  //  | hDecoration<"[", decorated<e>, "]"> --parens2 
//    | hDecoration<abbr, decorated<e>, abbr> --abbreviation
    | clause<e> --text
    
  clause<e> = wordDecorated<e> (clearance wordDecorated<e>)*

  pWordText (Word) =
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixedCase
    
  wordDecorated<d> =
//    | hTerm<pWordTokened> --tokened
    | hWordDecorated<pWordText, d>--word
//    | hTerm<digit+> --basicNumber
//    | word

  hWordDecorated<t, d> = t  &(d | wordEnd) 
  /*
  pDecorationToken (Word decoration token) = 
    em | b | i | u | abbr 
   */ 

  punctuation (Punctuation mark) = 
    ~alnum ~space ~nl any
}

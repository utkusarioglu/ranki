{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/api-v2"
    },
    {
      "path": "../../packages/rankilang-v2"
    },
    {
      "path": "../../plugins/grammar/constants-v2"
    },
    {
      "path": "../../plugins/parser/frame-v1"
    },
    {
      "path": "../../plugins/parser/base-v2"
    },
    {
      "path": "../../plugins/parser/params-v2"
    },
    {
      "path": "../../plugins/parser/frame-v2"
    },
    {
      "path": "../../plugins/grammar/rich-text-v2"
    },
    {
      "path": "../../plugins/grammar/rich-number-v2"
    },
    {
      "path": "../../plugins/grammar/rich-structure-v2"
    }
  ]
}

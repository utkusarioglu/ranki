RankiConfig {
  negation = "!"
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  quoteSingle = "\""
  quoteDouble = "'"

  directive = "%%%"
  frame = ":::"
  pause = "-"

  directiveShort = "%"
  frameShort = ":"

  h = "#"
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiRoot <: RankiConfig {
  document = whitespace documentList whitespace
  documentList = block? (blockSep block)*

  pauseDocument = whitespace pauseList whitespace
  pauseList = documentList (pauseSep documentList)*
  pauseSep = whitespace pause digit pause whitespace

  block 
    = shBlock wi ~pLine --sh
    | dirBlock wi ~pLine --dir
    | frBlock wi ~pLine --fr
    | p
  blockSep = (nl wi)+
  
  // Param
  param
    = paramKey wi assignment wi paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive
  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValue = paramValueItem (spaces paramValueItem)*
  paramValueItem
    = quoted<quoteSingle>
    | quoted<quoteDouble>
    | shInline
    | frInline
    | frBlock
    | paramValueItemPrimitive

  quoted<q> = q quotedContent<q>* q
  quotedContent<q> 
    = "\\" q --escaped
    | ~q any --content
  
  paramValueItemPrimitive
    = digit+ --number
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
  
  leftSepBlock 
    =   wi 
      sepLeft? wi 
        nl wi
  leftSepInline 
    =   wi 
      sepLeft wi
  paramListInline = param (leftSepInline param)*
  paramListBlock = param (leftSepBlock param)*
  
  // directive
  dirBlock
    = directive wi 
          wm+ 
        dirLeftBlock
        rightSepBlock 
        dirPayload 
      (directive | end)
  dirInline = directive wi dirLeftInline sepRight dirPayload directive
  dirLeftBlock = paramListBlock
  dirLeftInline = paramListInline
  dirPayload = document
  
  // Args
  rightSepBlock = wi sepRight? nl wi nl
  rightSepInline = wi sepRight wi 
    


  p = pLine (nl pLine)*
  pLine = indentation pContent (clearance pContent)*
  pContent 
    = shInline
    | dirInline
    | frInline
    | pProse
  pProse = pHeading? pDecoration (clearance pDecoration)*
  pHeading = h+ clearance
  pDecoration
    = em pDecoration em --emphasis
    | b pDecoration b --bold
    | i pDecoration i --idiomatic
    | u pDecoration u --underline
    | pText --text
  pText = pWord (clearance pWord)*
  pWordEnd = clearance | nl | end
  pWord
    = (~pIllegal digit)+ &pWordEnd --number
    | (~pIllegal upper)+ &pWordEnd --uppercase
    | (~pIllegal lower)+ &pWordEnd --lowercase
    | (~pIllegal letter)+ &pWordEnd --chars
    | (~pIllegal any)+ --mixed
  pIllegal = shInlineStartF | shInlineEnd | frame | directive | pause | nl | space | em | b | i | u 
  
  indentation = spaces
  wi (waste inline) 
    = spaces
  wm (waste multiline) 
    = spaces nl
  clearance = space+
  whitespace = wm* wi

  frInline = frStart wi frInlineConfig frame
  frInlineConfig
    = sepLeft wi 
        frLeftInline wi 
          sepRight wi
        frRightInline wi
          sepRight wi
        frInlinePayload  --clsrsp
    | sepRight wi
        frRightInline wi
          sepRight wi
        frInlinePayload  --srsp
    | sepRight wi
        frBlockPayload  --sp
    | sepLeft wi 
        frLeftInline wi 
          sepRight
        frInlinePayload  --clsp
    |   sepLeft wi 
        frLeftInline wi  --cl
    |   --e
      
  frStart = frame frType
  frBlockEnd
    = &(frame ~frType) frame --explicit
    | end --implicit
  frType = letter (space | letter)*
  frLeftInline = paramListInline
  frRightInline = paramListInline
  frLeftBlock = paramListBlock
  frRightBlock = paramListBlock
  frBlockPayload = pauseDocument
  frInlinePayload = pauseDocument
  
  // FRAME BLOCK
  frBlock =  frStart wi frBlockConfig frBlockPayload frBlockEnd
  frBlockConfig
    = frBlockLrpBV2 
    | frBlockLrpIV2
    | frBlockLpBV2
    | frBlockLpIV2
    | frBlockRpBV2
    | frBlockRpIV1
    | frBlockPV2
    | frBlockPV1
    
 frBlockPV1 (Ranki V1 payload blocks)
    =    sepRight wi 
          nl wi  --sP
    |     nl wi  --P
      
  frBlockPV2 (p family)
    =    sepRight wi 
          sepRight wi
          nl wi  --ssP

  frBlockRpIV1 (Ranki V1 right inline blocks)
    =    sepRight wi 
        frRightInline wi
          sepRight wi
          nl wi --srsP
    |     sepRight wi 
        frRightInline wi
          nl wi  --srP

  frBlockLrpIV2 (Ranki V2 lrp block)
    =     sepLeft wi
         frLeftInline wi
           sepRight wi
         frRightInline wi
           sepRight wi
           nl wi --clsrsP
    |      sepLeft wi
         frLeftInline wi
           sepRight wi
         frRightInline wi
           nl wi --clsrP
       
  frBlockLpIV2 (Ranki V2 lp block)
    =     sepLeft wi
         frLeftInline wi
           sepRight wi
           nl wi --clsP
     |     sepLeft wi
         frLeftInline wi
           nl wi  --clP
         
    frBlockLrpBV2 (Ranki V2 lrp Block family)
      =     sepLeft wi
          frLeftInline wi
            sepRight wi
            nl wi
          frRightBlock wi
            sepRight wi
            nl wi  --clsRsP
       |   sepLeft wi
          frLeftInline wi
            sepRight wi
            nl wi
          frRightBlock wi
            nl wi --clsRP
       |     sepLeft wi
            nl wi
          frLeftBlock wi
            sepRight wi
            nl wi
          frRightBlock wi
            sepRight wi
            nl wi  --cLsRsP
    |     sepLeft wi
          nl wi
        frLeftBlock wi
          nl wi
          nl wi
        frRightBlock wi
          nl wi
          nl wi --cLRP
         
  frBlockRpBV2 (Ranki V2 block rp family)
    =    sepRight wi
          nl wi
        frRightBlock wi
          sepRight wi
          nl wi --sRsP
    |     sepRight wi
          nl wi
        frRightBlock wi
          nl wi
          nl wi --sRP
      
  frBlockLpBV2 (Ranki V2 Lp Block family)
    =    sepLeft wi
          nl wi
        frLeftBlock wi
          sepRight wi
          nl wi --clsP
    |     sepLeft wi
          nl wi
        frLeftBlock
          nl wi
          nl wi --cLP
          
  shInlineStartF = directiveShort frameShort
  
  shInlineEnd 
  	= frameShort directiveShort --explicit
    | &nl --implilcit
  shBlockEnd
    = frameShort directiveShort --explicit
    | end --implicit
   
  shInline (Ranki V2 shorthand)
    = directiveShort wi
         dirLeftInline wi
       frameShort wi
         frType wi
         frInlineConfig
       shInlineEnd --df
     | directiveShort frameShort wi
         frType wi
         frInlineConfig
       shInlineEnd --f
   
  shBlock = shBlockDf | shBlockF 
  
  shBlockF 
    = shInlineStartF frType wi 
         frBlockConfig 
         frBlockPayload 
       shBlockEnd --f
  
  shBlockDf 
    = directiveShort wi 
           nl wi
         dirLeftBlock
           sepRight wi
           nl wi
       frameShort wi
         frType wi
         frBlockConfig
         frBlockPayload
       shBlockEnd --DsF
    | directiveShort wi 
         dirLeftInline
           sepRight wi
           nl wi
       frameShort wi
         frType wi
         frBlockConfig
         frBlockPayload
       shBlockEnd --dsF
     |  directiveShort wi 
           nl wi
         dirLeftBlock
           nl wi
           nl wi
       frameShort wi
         frType wi
         frBlockConfig
         frBlockPayload
       shBlockEnd --DF
}

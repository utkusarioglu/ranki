RankiConfig {
  root = ""

  //v1
  frameV1 = ":::"
  
  // v2
  pause = ","
  directive = "%"
  frame = ":"
  
  // params
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  negation = "!"

  // line alteration tokens
  align = "$"
  h = "#"
  small = "_"
  
  // text decoration tokens
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"

  // language tokens
  esc = "\\"
  sentence = "." | "!" | "?"

  divider = "~"
  
  // number tokens
  complexUnits = "i" | "j" | "k"
}

{
  "extends": "@ranki/config-typescript/tsconfig.app.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "types",
    "useDefineForClassFields": true,
    "experimentalDecorators": true,
    "paths": {
      "@dqm/package-dqm-v2": ["../../packages/dqm-v2/*"],
      "@dqm/package-dqm-v2-debug": ["../../packages/dqm-v2-debug/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../../packages/dqm-v2"
    },
    {
      "path": "../../packages/dqm-v2-debug"
    }
  ]
}

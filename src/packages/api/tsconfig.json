{
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "composite": true
  },
  "include": [
    "src/types/*",
    "src/helpers/*",
    "src/constants/*",
    "src/types/stages/ast.mts",
    "src/types/stages/render.mts",
    "src/types/stages/transform.mts",
    "src/types/stages/validation.mts"
  ]
}

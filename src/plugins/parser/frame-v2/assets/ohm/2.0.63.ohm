RankiFrameV2 <: RankiParamsV2 {
  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2
    | ...

  paramValueItem :=
    | v2 --v2
    | ...
  
  pauseRoot = whitespace pauseList whitespace
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*

  v2PayloadPlain =  (~pauseStart ~tFrameV2Directive ~v2End any)+
  
  v2PayloadSectionItem = 
    | v2 --v2
    | v2PayloadPlain --plain
  
  v2PayloadSection = v2PayloadSectionItem (whitespace v2PayloadSectionItem)*

  pauseStart = tFrameV2Pause digit* tFrameV2Pause
  pauseEnd = tFrameV2Pause tFrameV2Pause
  pausedContainer = whitespace pauseStart pausedPayload pauseEnd whitespace

  // !FIX this would break with nested pauses
  pausedPayload = (~pauseEnd ~v2End any)+
  
  v2Type = letter+ (clearance letter+)* 
  
  v2Payload = 
    | wi nl pauseRoot --P
    | pauseRoot --p

  v2End =
    | tFrameV2Frame "-"? digit+ tFrameV2Directive --exact
    | tFrameV2Frame tFrameV2Directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2ParamListBlock whitespace --D  
    | wi v2ParamListInline wi --d  
  
  v2FrameConfigFp =
    | wi 
        v2Type wi 
          v2ParamListBlockContainer wi
          tParamsV2SeparatorFrame?  --F
    |   wi 
      v2Type wi 
        v2ParamListInlineContainer wi 
        tParamsV2SeparatorFrame?  --f

  v2FrameConfigP = wi v2Type wi (tParamsV2SeparatorFrame | nl)

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | tFrameV2Directive v2DirectiveConfig tFrameV2Frame v2FrameConfig v2Payload v2End --dfp
    | tFrameV2Directive tFrameV2Frame v2FrameConfig v2Payload v2End --fp
    | tFrameV2Directive tFrameV2Frame wi v2Type wi v2End --e 
}

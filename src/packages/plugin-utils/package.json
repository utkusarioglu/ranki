{
  "private": true,
  "name": "@dqm/package-plugin-utils",
  "type": "module",
  "exports": {
    "./bundler": {
      "import": "./lib/bundler.mjs",
      "types": "./types/bundler.d.mjs"
    },
    ".": {
      "import": "./lib/export.mjs",
      "types": "./types/export.d.mjs"
    }
  },
  "scripts": {
    "build": "yarn tsc",
    "watch": "tsc --watch --preserveWatchOutput --preserveWatchOutput",
    "test": "vitest",
    "clean-all": "rm -rf .turbo lib dist types node_modules tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@dqm/package-dqm-api-v2": "workspace:^",
    "@ranki/config-typescript": "workspace:^",
    "@types/node": "^25.6.0",
    "ohm-js": "^17.2.1",
    "typescript": "^5.9.2"
  }
}

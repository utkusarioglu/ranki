{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "typescript.tsdk": ".yarn/sdks/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.log": "off",
  "remote.autoForwardPorts": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "[!s]*/**": true,
    "s[!r]*/**": true,
    "sr[!c]*/**": true,
    "src/[!a]*/**": true,
    "src/a[!p]*/**": true,
    "src/ap[!p]*/**": true,
    "src/app[!s]*/**": true,
    "src/apps/[!r]*/**": true,
    "src/apps/r[!a]*/**": true,
    "src/apps/ra[!n]*/**": true,
    "src/apps/ran[!k]*/**": true,
    "src/apps/rank[!i]*/**": true,
    "src/apps/ranki[!-]*/**": true,
    "src/apps/ranki-[!v]*/**": true,
    "src/apps/ranki-v[!2]*/**": true
  },
  "[html]": {
    "editor.defaultFormatter": null
  }
}

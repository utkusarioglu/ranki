RankiRichNumberV2 <: RankiBaseV2 {
  groupedDigits3 =
    | digit digit digit --three
    | groupedDigits2

  groupedDigits2 =
    | digit digit --two
    | digit --one

  numberSystemInternational = groupedDigits3 (groupToken groupedDigits3_three)+
  numberSystemIndian = groupedDigits2 groupToken (groupedDigits2_two groupToken)+ groupedDigits3_three --lakhCrore
  numberSystemUnstructured = hBasicGroup<digit>

  numberSystem = 
    | numberSystemIndian --indian
    | numberSystemInternational --international
    | &(digit+ groupToken) numberSystemUnstructured --unstructured
    | digit+ --basic

  integer (Integer) = 
    | sign numberSystem --signed
    | numberSystem --unsigned
    
  // decimal (Decimal number) = 
  //   | sign integer_unsigned decimalToken integer_unsigned --full
  //   | sign decimalToken integer_unsigned --point

  decimal (Decimal number) = 
    | integer decimalToken integer_unsigned --full
    | sign decimalToken integer_unsigned --point
    
  eNotation (Base 10 scientific notation) = scalar eToken integer
    
  complex (Complex Number) = 
   | scalar clearance complexOperator clearance scalar complexToken --si
   | scalar clearance complexOperator clearance complexToken scalar --is
   | scalar clearance complexOperator clearance complexToken --i

  complexOperator = sign

  scalar (Scalar Number) =
    | decimal
    | integer

  rational = number rationalToken number

  // hConcept<token> =
  //   | negativeToken token --negative
  //   | positiveToken token --positive
  //   | token --unsigned
  
  conceptualSymbol = 
    | infinityToken --infinity
    | eToken --e
    | piToken --pi

  conceptualNumber = 
    | digit+ conceptualSymbol --factored
    | conceptualSymbol --bare

  conceptual = 
    | sign conceptualNumber --signed
    | conceptualNumber --unsigned

  sign = 
    | ("+-" | "±") --plusMinus
    | ("-+" | "∓") --minusPlus
    | "+" --plus
    | "-" --minus
    | "" --none

  hBasicGroup<range> = range (groupToken? range)*
  hBases<symbol, range> = "0" symbol numberSystem_unstructured

  octal = sign hBases<octalToken, ("0".."7")>
  binary = sign hBases<binaryToken, ("0" | "1")>
  hexadecimal = sign hBases<hexadecimalToken, ("0".."9" | "a".."f" | "A".."F")>

  bases = 
    | hexadecimal
    | binary
    | octal

  number := 
    | rational
    | eNotation 
    | bases
    | conceptual
    | complex 
    | scalar 
    | ...
    
  word :=
    | number
    | ...
}

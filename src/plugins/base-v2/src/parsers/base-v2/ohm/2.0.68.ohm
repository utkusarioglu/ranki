BaseV2 <: ConstantsV2 {
  baseV2RootBlock := 
    | tBaseV2Ignore sBaseV2WasteMultiline baseV2Ignored --ignored
    | sBaseV2Whitespace baseV2Structure sBaseV2Whitespace --structured

  baseV2RootLine = sBaseV2WasteInline baseV2Lexemes sBaseV2WasteInline

  baseV2Structure = baseV2Section --base

  baseV2Ignored = any*

  baseV2Section =  
    | baseV2Block (baseV2BlockSep baseV2Block)* --base
    | "" --empty
    
  baseV2BlockSep = nl sBaseV2WasteInline (nl sBaseV2WasteInline)+ --base
  
  baseV2Block = 
    | baseV2P --baseV2P
  
  baseV2P = baseV2Line (nl baseV2Line)*
  
  baseV2Line = sBaseV2Indentation baseV2LineModifiers baseV2Lexemes sBaseV2WasteInline
  baseV2LineModifiers  = ""
    
  baseV2Lexemes = baseV2Lexeme (sBaseV2Clearance baseV2Lexeme)*
  
  baseV2Lexeme = 
    | baseV2Decorated --none

  baseV2Decorated = 
    | baseV2Word &tBaseV2WordEnd --base
    | hChar<~(nl | space) any>+ &tBaseV2WordEnd --fallback
 
  /*
  !FIX word base accepts a word like yes". it accepts the quote at the end, which
  doesn't seem right
  */
  baseV2Word = 
    | baseV2Number --baseV2Number
    | hChar<~(nl | space | end) any>+ --base
  
  baseV2Number (Number) = 
    | digit+ --digits
  
  tBaseV2WordEnd =  sBaseV2Clearance | nl | end

  hWord<t> = t &tBaseV2WordEnd
  
  hCheck<t> = &t t
  
  tBaseV2QuoteSingle =
    | "'" --open
    | "'" --close
    
  tBaseV2QuoteDouble =
    | "\"" --open
    | "\"" --close

  tBaseV2BracketRound = 
    | "(" --open
    | ")" --close
  
  tBaseV2BracketSquare =
    | "[" --open
    | "]" --close
  
  tBaseV2BracketCurly = 
    | "{" --open
    | "}" --close
    
  baseV2Quotes = 
    | tBaseV2QuoteSingle --single
    | tBaseV2QuoteDouble --double
    
  baseV2Brackets = 
    | tBaseV2BracketRound --round
    | tBaseV2BracketSquare --square
    | tBaseV2BracketCurly --curly

  tBaseV2WordToken = ""
  tBaseV2LineToken = ""

  hChar<c> = 
    | tBaseV2Escape tBaseV2WordToken --escaped
    | tBaseV2Escape c --redundant
    | c --regular
    
  sBaseV2Indentation = spaces
  sBaseV2Clearance = space+
  
  sBaseV2WasteMultiline (waste multiline) 
    = spaces nl
    
  sBaseV2WasteInline (waste inline) 
    = spaces
    
  sBaseV2Whitespace = sBaseV2WasteMultiline* sBaseV2WasteInline
  
  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

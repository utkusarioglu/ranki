{
  "extends": "@ranki/config-typescript/tsconfig.package.json",
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "strict": true,
    "composite": true,
    "declarationDir": "types",
    "outDir": "lib",
    "rootDir": "src",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"]
}

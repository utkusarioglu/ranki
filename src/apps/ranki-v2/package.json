{
  "name": "@ranki/app-ranki-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "exports": {
    "./constants": {
      "import": "./lib/export.constants.mjs",
      "types": "./types/export.constants.d.mts",
      "default": "./lib/export.constants.mjs"
    },
    "./types": {
      "types": "./types/export.types.d.mts"
    }
  },
  "scripts": {
    "dev": "vite",
    "lib": "tsc -p tsconfig.lib.json",
    "build": "yarn lib && vite build",
    "test": "yarn test-type-check && yarn vitest",
    "test-type-check": "yarn tsc -p tsconfig.test.json",
    "preview": "vite preview",
    "clean-targets": "yarn tsx scripts/clean-targets.ts && scripts/clean-anki.sh",
    "clean-anki": "scripts/clean-anki.sh",
    "copy-to-targets": "yarn tsx scripts/copy-to-targets.ts",
    "clean-all": "rm -rf .turbo lib dist types node_modules tsconfig*.tsbuildinfo && rm -rf vite*timestamp-* || true"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@ranki/config-typescript": "workspace:^",
    "@rollup/plugin-babel": "^6.1.0",
    "@types/node": "^25.0.6",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "chalk": "^5.6.2",
    "csstype": "^3.2.3",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "sirv": "^3.0.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@dqm/package-dqm-utils": "workspace:^",
    "@dqm/package-dqm-v2": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-document-load": "^0.66.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@ranki/package-anki-ui": "workspace:^",
    "core-js": "^3.47.0",
    "expr-eval": "^2.0.2",
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.2",
    "yaml": "^2.8.2",
    "zustand": "^5.0.13"
  }
}

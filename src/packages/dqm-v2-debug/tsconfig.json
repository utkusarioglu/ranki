{
  "extends": "@ranki/config-typescript/tsconfig.package.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "types",
    "paths": {
      "@dqm/package-dqm-api-v2": ["../dqm-api-v2/*"],
      "@dqm/package-dqm-utils": ["../dqm-utils/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../dqm-utils"
    },
    {
      "path": "../dqm-api-v2"
    }
  ]
}

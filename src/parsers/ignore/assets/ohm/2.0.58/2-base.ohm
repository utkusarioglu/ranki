RankiBase <: RankiConfig {
  document := 
    | indentation directive clearance "ignore" wm any* --ignore
    | whitespace sections whitespace --blocks
    
  sections = section (sectionSep section)* 
  sectionSep = nl wi nl wi (nl wi)+
    
  section = blocks
    
  blocks = 
    | block (blockSep block)* --populated
    | "" --empty
    
  blockSep = nl wi nl wi
  
  block  = 
    | p --p
  
  p = line (nl line)*
  
  line = indentation lineModifiers lexemes wi
  lineModifiers  = ""
    
  lexemes = lexeme (clearance lexeme)*
  
  lexeme = decorated

  decorated = 
    | word &wordEnd --base
    | hChar<~(nl | space) any>+ &wordEnd --fallback
 
  word = 
    | number --number
    | hChar<~(nl | space | end) any>+ --base
  
  number (Number) = 
    | digit+ --digits
  
  wordEnd =  clearance | nl | end

  hWord<t> = t &wordEnd
  
  hCheck<t> = &t t
  
  quoteSingle =
    | "'" --open
    | "'" --close
    
  quoteDouble =
    | "\"" --open
    | "\"" --close

  bracketRound = 
    | "(" --open
    | ")" --close
  
  bracketSquare =
    | "[" --open
    | "]" --close
  
  bracketCurly = 
    | "{" --open
    | "}" --close
    
  quotes = 
    | quoteSingle --single
    | quoteDouble --double
    
  brackets = 
    | bracketRound --round
    | bracketSquare --square
    | bracketCurly --curly

  wordToken = ""
  lineToken = ""

  hChar<c> = 
    | esc wordToken --escaped
    | esc c --redundant
    | c --regular
    
  indentation = spaces
  clearance = space+
  
  wm (waste multiline) 
    = spaces nl
    
  wi (waste inline) 
    = spaces
    
  whitespace = wm* wi
  
  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

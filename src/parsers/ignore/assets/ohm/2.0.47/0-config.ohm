RankiConfig {
  //v1
  frameV1 = ":::"
  
  // v2
  pause = ","
  directive = "%"
  frame = ":"
  
  // params
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  negation = "!"

  // line alteration tokens
  align = "$"
  h = "#"
  small = "_"
  
  // text decoration tokens
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"
  quoteSingle = "\""
  quoteDouble = "'"
  
  // language tokens
  esc = "\\"
  sentenceSep = "." | "!" | "?"
  
  // number tokens
  complexUnits = "i" | "j" | "k"

  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

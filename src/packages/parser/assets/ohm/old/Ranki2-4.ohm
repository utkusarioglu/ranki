Ranki {
  Document = Group*
  
  Group = Macro | Element
  
  Macro = MACRO_TAG Params Element* (MACRO_TAG | end)
  
  Param = Word ("=" Element)?
  Params =  (Param ",")* Param

  Element = Block | Text

  Block = BLOCK_TAG BlockHeader SEMI_OR_EOL Params? SEMI BlockContent (BLOCK_TAG | end)  --withParams
        | BLOCK_TAG BlockHeader SEMI_OR_EOL BlockContent (BLOCK_TAG | end)                     --noParams

  BlockHeader = Word ("," Params)?

  BlockContent = (Text | Block)*

  Word = letter+

  Text = (~(BLOCK_TAG | MACRO_TAG) any)+

  BlockStart = BLOCK_TAG Word COMMA
  BLOCK_TAG = ":::"
  MACRO_TAG = "%%%"
  eol =  ("\r"? "\n")
  SEMI = ";"
  SEMI_OR_EOL = ";" | eol
  COMMA = "," eol?
}

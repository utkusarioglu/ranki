{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "lib/**"],
      "inputs": ["src/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["src/**", "test/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false
    },
    "clean-all": {
      "cache": false
    },
    "lint": {}
  }
}

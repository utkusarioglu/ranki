RankiConfig {
  document = ""
  //v1
  frameV1 = ":::"
  
  // v2
  pause = ","
  directive = "%"
  frame = ":"
  
  // params
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  negation = "!"

  // line alteration tokens
  align = "$"
  h = "#"
  small = "_"
  
  // text decoration tokens
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"

/*
  quoteDouble = "\""
  quoteSingle = "'"
  
  roundOpen = "("
  roundClose = ")"
  squareOpen = "["
  squareClose = "]"
  curlyOpen = "{"
  curlyClose = "}"
*/


  // language tokens
  esc = "\\"
  sentence = "." | "!" | "?"
  
  // number tokens
  complexUnits = "i" | "j" | "k"
}

/*
( )	Parentheses or Round Brackets
[ ]	Square Brackets or Box Brackets
{ }	Braces or Curly Brackets
< >	Angle Brackets or Chevrons
*/

RankiIgnore <: RankiConfig {
  document := indentation directive clearance "ignore" wm any* --ignore
  
  indentation = spaces
  clearance = space+
  
  wm (waste multiline) 
    = spaces nl
    
  wi (waste inline) 
    = spaces
    
  whitespace = wm* wi
  
  // unchangeable tokens
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiBasic <: RankiIgnore {
  document := 
    | ... 
    | whitespace blocks whitespace --blocks
    
  blocks = block? (blockSep block)*
  blockSep = (nl wi)+
  
  block  = 
    | p --p
  
  p = line (nl line)*
  
  // line = indentation plaintext wi
  line = indentation lineModifiers lexemes wi
    lineModifiers  = ""
    
      lexemes = lexeme (clearance lexeme)*
  
  lexeme = decorated

  decorated = 
    | hChar<~nl ~space any>+ &wordEnd --any
 
  word = ""
  
  wordEnd =  clearance | nl | end

  hWord<t> = t &wordEnd
  
  hCheck<t> = &t t
  
  quoteSingle =
    | "'" --open
    | "'" --close
    
  quoteDouble =
    | "\"" --open
    | "\"" --close

  bracketRound = 
    | "(" --open
    | ")" --close
  
  bracketSquare =
    | "[" --open
    | "]" --close
  
  bracketCurly = 
    | "{" --open
    | "}" --close
    
  quotes = 
    | quoteSingle --single
    | quoteDouble --double
    
  brackets = 
    | bracketRound --round
    | bracketSquare --square
    | bracketCurly --curly


  wordToken = ""
  lineToken = ""

  hChar<c> = 
    | esc wordToken --escaped
    | esc c --redundant
    | c --regular
}

RankiRichText <: RankiBasic {
  document := ...
  
  lineModifiers := alignment smalltext heading

  smalltext =
    | &(small+ ~clearance) --decoration
    | small+ clearance --small
    | ~small --normal

  heading (Line heading level qualifier) = 
    | &(h+ ~clearance) --decoration
    | h+ clearance --heading
    | ~h --normal
    
  alignment (Line alignment qualifier) =
    | &(align+ ~clearance) --decoration
    | ~align --unaligned
    | align+ clearance --aligned



  lexeme := 
    | textual --textual
    | ...

  textual = decorated (clearance decorated)*

  decorated := 
    | word &wordEnd --bare
    | hChar<inWordToken>* word hChar<inWordToken>* &wordEnd--decorated
    | hChar<inWordToken>+ &wordEnd --token
    | hChar<inWordToken>* hChar<~wordEnd ~inWordToken any>+ hChar<inWordToken>* &wordEnd--richAny
    | ...

  word :=
    | text --chars
    | hChar<digit>+ --digits
    | hChar<punctuation>+ --punctuation
    | hChar<(letter | digit | punctuation)>+ --mixed
    | ...

  text (Word) =
    | hChar<upper> hChar<lower>+ --proper
    | hChar<upper>+ --uppercase
    | hChar<lower>+ --lowercase
    | hChar<letter>+ --mixedcase

  inWordToken = wordToken | sentence | lineToken | esc ~lineToken

  punctuation (Punctuation mark) = 
    ~alnum ~space ~nl ~digit ~inWordToken any

  // they come at the start of lines to alter their behavior
  lineToken := align | h | small
  
  // they come at the beginning or end of words to alter their behavior
  wordToken := 
    | em --emphasis
    | b --bold
    | i --idiomatic
    | u --underlined
    | abbr --abbreviation
    | quotes
    | brackets
}

RankiNumber <: RankiRichText {
  document := ...

  integer (Integer) = 
    | "-"? digit+  --signed
    | digit+ --unsigned
    
  decimal (Decimal number) = 
    | "-"? digit* "." digit+ --signed
    | digit* "." digit+ --unsigned
    
  eNotation (Base 10 scientific notation) = "-"? digit* ("." digit+)? "e" integer
  
  hComplex<real, imaginary> = 
   | real clearance ("+" | "-") clearance imaginary complexUnits --bi
   | real clearance ("+" | "-") clearance complexUnits imaginary --ib
    
 complex (Complex Number) = hComplex<scalar, scalar>

 scalar (Scalar Number)= 
    | eNotation --eNotation
    | decimal --decimal
    | integer --integer
    
  number (number type )= 
    | complex --complex
    | scalar --scalar
    
  word :=
    | number
    | ...
}

RankiFrameV2 <: RankiRichText {
  

  // maybe a simpler construct than `line` would work here
  block :=
    | indentation v2 wi &(nl | end) --v2 
    | ...
    
  word :=
    | v2
    | ...
    
  pauseDocument = whitespace pauseList whitespace
  pauseList = v2PayloadSection (pausedContainer v2PayloadSection)*



  v2PayloadPlain =  (~pauseStart ~directive ~v2End any)+
  v2PayloadSection = 
    | ((v2 | v2PayloadPlain) whitespace)*


  pauseStart = pause digit? pause
  pauseEnd = pause pause
  pausedContainer = whitespace pauseStart whitespace pausedPayload whitespace pauseEnd whitespace
  pausedPayload = (~pauseEnd ~v2End any)+

  param =
    | paramKey wi assignment wi paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive
    
  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValue = paramValueItem (spaces paramValueItem)*
  
  paramValueItem = 
    | quoted<quoteSingle>
    | quoted<quoteDouble>
    | v2
    | paramValueItemPrimitive

  quoted<q> = q quotedContent<q>* q
  quotedContent<q> = 
    | "\\" q --escaped
    | ~q any --content
  
  paramValueItemPrimitive =
//    | eNotation --eNotation
 //   | decimal --decimal
 //   | integer -- integer
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
    
  sepLeftInline = wi sepLeft wi
  sepLeftBlock = wi sepLeft? wi nl wi
  sepRightBlock = wi sepRight? wi nl wi
  v2paramListInline = param (sepLeftInline param)*
  v2paramListBlock = param (sepLeftBlock param)*
  
  v2Type = letter (space | letter)*
  
  v2Payload = 
    | wi nl pauseDocument --P
    | pauseDocument --p
    
   v2End =
    | frame "-"? digit+ directive --exact
    | frame directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2paramListBlock whitespace --D  
    | wi v2paramListInline wi --d

  v2FrameConfigFp =
    | wi 
        v2Type wi 
          sepLeft wi 
          nl wi 
        v2paramListBlock wi 
          sepLeft? wi
          sepRight?  --F
    |   wi 
      v2Type wi 
        sepLeft wi 
      v2paramListInline wi 
        sepLeft? wi 
        sepRight?  --f

  v2FrameConfigP = wi v2Type wi sepRight

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | directive v2DirectiveConfig frame v2FrameConfig v2Payload v2End --dfp
    | directive frame v2FrameConfig v2Payload v2End --fp
}

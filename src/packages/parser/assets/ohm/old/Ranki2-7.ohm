Ranki  {
  Document (Sections need to be separated by two new lines)
    = ListOf<Section, nl2>
  
  space := " " | "\t"
  nl = "\n" | "\r"
  nl2 = nl nl
  c = ","
  s = ";"
  a = "="
  dir = "%%%"
  fr = ":::"
  
  sep<char, ln>
    = char? ln --multi
    | char --single
  
  Section = Directive | Frame
  
  Text = (~(fr | dir) any)+
  
  FrameAttrs = (sep<c, nl> ListOf<Param, sep<c, nl>>)
  FrameParams = ListOf<Param, sep<c, nl>>
  FrameSep = sep<s, nl2>
  FrameType = letter+
  FrameContent
    = Frame
    | Text
  FrameSpec
    = FrameType FrameAttrs? FrameSep FrameParams FrameSep FrameContent+ --three
    | FrameType FrameAttrs? FrameSep FrameContent+                      --two
    | FrameType FrameAttrs? nl*                                         --one
    
  Frame = Wrap<fr, FrameSpec>
    | Paragraph
    
  Paragraph = Frame | Text
  
  DirectiveSpec = ListOf<Param, c> s Frame+
  Directive = Wrap<dir, DirectiveSpec>
  
  Wrap<Tag, Spec> = Tag Spec (Tag | end)
    
  Param
    = letter+ a alnum+ --kwarg
    | letter+ --arg
}

// collection, volume, chapter, article, section, block
RankiRichStructure <: RankiBase {
  root := richStructure

  sectionSep :=
    | structureSep<"section">
    | ...

  richStructure = hLevel<"collection", collection>

  collection = hLevel<"volume", volume>

  volume = hLevel<"chapter", chapter>

  chapter = hLevel<"article", article>

  hStructureSep<name> = 
    | structure+ wi nl wi caseInsensitive<name> wi nl wi structure+ --block
    | structure+ wi caseInsensitive<name> wi structure+ --inline

  hLevel<name, type> =
    | type (hStructureSep<name> type) --defined
    | "" --empty
}

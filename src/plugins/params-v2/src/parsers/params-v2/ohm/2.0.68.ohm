ParamsV2 <: BaseV2 {
  paramsV2ParamListBlockContainer = tParamsV2SeparatorParam sBaseV2WasteInline 
          nl sBaseV2WasteInline 
        paramsV2ParamListBlock sBaseV2WasteInline 
          tParamsV2SeparatorParam?
  
  paramsV2ParamListInlineContainer = tParamsV2SeparatorParam sBaseV2WasteInline 
      paramsV2ParamListInline sBaseV2WasteInline 
        tParamsV2SeparatorParam?
        
  paramsV2SepLeftInline = sBaseV2WasteInline tParamsV2SeparatorParam sBaseV2WasteInline
  paramsV2SepLeftBlock = sBaseV2WasteInline tParamsV2SeparatorParam? sBaseV2WasteInline nl sBaseV2WasteInline
  paramsV2ParamListInline = paramsV2Param (paramsV2SepLeftInline paramsV2Param)*
  paramsV2ParamListBlock = paramsV2Param (paramsV2SepLeftBlock paramsV2Param)*

  paramsV2Operator =
    | tParamsV2OperatorRemove
    | tParamsV2OperatorAppend
    | tParamsV2OperatorAssign

  paramsV2Param =
    | paramsV2Directive
    | paramsV2Setting

  paramsV2FormatOperator = 
    paramsV2Key sBaseV2WasteInline 
    paramsV2Operator sBaseV2WasteInline 
    paramsV2Values 

  paramsV2FormatNegative = tParamsV2Negation paramsV2Key
  paramsV2FormatPositive = paramsV2Key
  paramsV2FormatPositional = paramsV2ValueItem

  paramsV2SettingNamespace = digit+ "."

  paramsV2Setting = 
    | paramsV2SettingNamespace? paramsV2FormatOperator 
    | paramsV2SettingNamespace? paramsV2FormatNegative
    | paramsV2SettingNamespace? paramsV2FormatPositive
    | paramsV2SettingNamespace? paramsV2FormatPositional

  paramsV2Directive = 
    | tParamsV2DirectiveParam paramsV2FormatOperator 
    | tParamsV2DirectiveParam paramsV2FormatNegative
    | tParamsV2DirectiveParam paramsV2FormatPositive
    | tParamsV2DirectiveParam paramsV2FormatPositional

  paramsV2KeyWordLegal = alnum | "_" | "-"
  paramsV2KeyWord = letter (paramsV2KeyWordLegal)*
  paramsV2Key = paramsV2KeyWord ("." paramsV2KeyWord)*

  paramsV2Values = paramsV2ValueItem (sBaseV2Clearance paramsV2ValueItem)*

  paramsV2ValueItem = 
    | hQuoted<tBaseV2QuoteSingle>
    | hQuoted<tBaseV2QuoteDouble>
    | paramsV2ValueItemPrimitive
    
  hQuoted<q> = q hQuotedContent<q>* q
  hQuotedContent<q> = 
    | tBaseV2Escape q --escaped
    | ~q any --content

  paramsV2ValueItemPrimitive =
    | baseV2Number --number
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | &(upper+ sBaseV2Clearance) upper+ --uppercase
    | &(lower+ sBaseV2Clearance) lower+ --lowercase
    | &(letter+ sBaseV2Clearance) letter+ --chars
    | (letter | digit)+ --mixed
}

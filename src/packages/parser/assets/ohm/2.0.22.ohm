RankiGrammar <: RankiConfig {
  document = whitespace nonemptyListOf<section, nl+>

  // space := " " | "\t"
  // nl = "\n" | "\r"

  // Separators
  indentation = spaces
  clearance = space+
  whitespace = sb<nl>*
  sb<elem> = spaces elem spaces
  wrap<wrapper, elem> = wrapper (~wrapper elem)* wrapper
  sl<elem> = spaces elem
  sp<char> (separator)
    = sb<char?> nl --multiline
    | sb<char> --singleline

  // shorthands
  sArg = sp<sep_argument>
  sPar = sp<sep_parameter>

  // Params
  paramValueItemQuoted 
    = wrap<quote_double, any> --double
    | wrap<quote_single, any> --single
  paramValueItemPrimitive
    = digit+ --number
    | ("true" | "false") --boolean
    | letter+ --word
  paramValueItem
    = paramValueItemQuoted
    | fr
    // | fr_inline
    // | fr_block
    | paramValueItemPrimitive
  paramValue = nonemptyListOf<paramValueItem, spaces>
  paramKey = ("_" | lower)+
  param 
    = paramKey sb<assignment> paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive
  params = listOf<param, sPar> sPar?
  
  section = dir | block

  dirContent = document
  dir = directive sb<nl?> params sArg dirContent sb<nl?> (directive | end)
  
  block = fr ~(spaces nonemptyListOf<lineWord, spaces>) | paragraph

  // Text
  lineBreak = nl
  paragraph = lineList<line, lineBreak> nl?
  lineList<elem, sep> 
    = elem (sep elem)*
  line
    = indentation h+ clearance line spaces --heading
    | indentation lineContentList<lineContent, clearance> spaces --default
  lineContentList<elem, sep> 
    = elem (sep elem)*
  lineContent = fr | lineWord
  lineWord
    = wrap<em, lineWord> --emphasis
    | wrap<b, lineWord> --bold
    | wrap<i, lineWord> --i
    | lineWordPrimitive --primitive
  lineWordPrimitive
    = lineCharUpper+ --uppercase
    | digit+ --number
    | lineChar+ --mixed
  lineCharIllegal = fr | directive | space | nl | pause
  lineCharUpper = ~lineCharIllegal upper
  lineChar = ~lineCharIllegal any

  // frame
  frTag = letter+
  frTagList = nonemptyListOf<frTag, spaces>
  frConfig
    = sPar params sArg params sArg --ap
    | sPar params sArg --a
    | sArg params sArg --p
    | sep_argument? --e
  frContent = (~frame any)*
  fr = indentation frame sl<frTagList> frConfig frContent (frame | end)
}

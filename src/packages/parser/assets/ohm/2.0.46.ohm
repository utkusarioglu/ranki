RankiConfig {
  negation = "!"
  sepLeft = ","
  sepRight = ";"
  assignment = "="
  quoteSingle = "\""
  quoteDouble = "'"

  frameV1 = ":::"
  
  pause = ","
  directive = "%"
  frame = ":"

  align = "$"
  h = "#"
  em = "+"
  b = "*"
  i = "/"
  u = "_"
  abbr = "@"
  esc = "\\"
  
  space := " " | "\t"
  nl = "\n" | "\r"
}

RankiIgnore <: RankiConfig {
  document = directive clearance "ignore" wm any*--ignore
  
  clearance = space+
  wm (waste multiline) 
    = spaces nl
}

RankiText <: RankiIgnore {
  document := 
    | ... 
    | whitespace documentList whitespace --blocks
    
  documentList = block? (blockSep block)*
  blockSep = (nl wi)+
  block  = p

  p = pLine (nl pLine)*
  pLine = indentation pAlignment pHeading pContent (clearance pContent)* wi
  pContent = pProse

  pProse = pDecoration (clearance pDecoration)*
  
  pHeading = 
    | h+ clearance --heading
    | &(~h) --text
    
  pAlignment =
    | align align clearance --right
    | align clearance --center
    | &(~align) --left

  pDecoration =
    | em pDecoration em --emphasis
    | b pDecoration b --bold
    | i pDecoration i --idiomatic
    | u pDecoration u --underline
    | abbr pDecoration abbr --abbreviation
    | pText --text
    
  pText = pWord (clearance pWord)*
  pWordTerminator = clearance | nl | end | em | b | i | u | abbr
  
  pWord =
    | (&pChar scientific)+ &pWordTerminator --scientific
    | (&pChar float)+ &pWordTerminator --float
    | (&pChar integer)+ &pWordTerminator --integer
    | (&pChar digit)+ &pWordTerminator --number
    | (&pChar upper)+ &pWordTerminator --uppercase
    | (&pChar lower)+ &pWordTerminator --lowercase
    | (&pChar letter)+ &pWordTerminator --chars
    | pChar+ &pWordTerminator --mixed
  
  pChar =
    | esc any --escaped 
    | ~pIllegal any --legal
    
  pIllegal = nl | space | em | b | i | u 
  
  indentation = spaces
  wi (waste inline) 
    = spaces

  whitespace = wm* wi
  
  integer = "-"? digit+
  float = "-"? digit* "." digit+
  scientific = "-" digit* ("." digit+)? "e" integer
}

RankiV2 <: RankiText {
  document := ...
  pIllegal := frame | directive | pause |  ...
  
  block := 
    | indentation v2 wi ~pLine --v2
    | ...
    
  pContent := v2 | ...
  
  pauseDocument = whitespace pauseList whitespace
  pauseList = documentList (pausedDocument documentList)*
  pauseStart = pause integer? pause
  pausedDocument = whitespace pauseStart whitespace document whitespace pause pause whitespace

  param =
    | paramKey wi assignment wi paramValue --assignment
    | negation paramKey --negative
    | paramKey --positive
    
  paramKey = letter (paramKeyLegal)*
  paramKeyLegal = letter | "_" | "-"
  paramValue = paramValueItem (spaces paramValueItem)*
  
  paramValueItem = 
    | quoted<quoteSingle>
    | quoted<quoteDouble>
    | v2
    | paramValueItemPrimitive

  quoted<q> = q quotedContent<q>* q
  quotedContent<q> = 
    | "\\" q --escaped
    | ~q any --content
  
  paramValueItemPrimitive =
    | scientific --scientific
    | float --float
    | integer -- integer
    | caseInsensitive<"true"> --true
    | caseInsensitive<"false"> --false
    | upper+ --uppercase
    | lower+ --lowercase
    | letter+ --mixed
    
  sepLeftInline = wi sepLeft wi
  sepLeftBlock = wi sepLeft? wi nl wi
  sepRightBlock = wi sepRight? wi nl wi
  v2paramListInline = param (sepLeftInline param)*
  v2paramListBlock = param (sepLeftBlock param)*
  sepRightInline = wi sepRight wi
  
  v2Type = letter (space | letter)*
  
  v2Payload = 
    | wi nl pauseDocument --P
    | pauseDocument --p
    
  v2End =
    | frame integer? directive --explicit
    | end --implicit

  v2DirectiveConfig =
    | wi nl wi v2paramListBlock whitespace --D  
    | wi v2paramListInline wi --d

  v2FrameConfigFp =
    | wi 
        v2Type wi 
          sepLeft wi 
          nl wi 
        v2paramListBlock wi 
          sepLeft?  --F
    |   wi 
      v2Type wi 
        sepLeft wi 
      v2paramListInline wi 
        sepLeft?  --f

  v2FrameConfigP = wi v2Type

  v2FrameConfig =
    | v2FrameConfigFp --fp
    | v2FrameConfigP --p

  v2 = 
    | directive v2DirectiveConfig frame v2FrameConfig v2Payload v2End --dfp
    | directive frame v2FrameConfig v2Payload v2End --fp
}

RankiV1 <: RankiV2 {
  document := ...
  pContent := v1Inline | ...
  block := 
    | indentation v1Block wi ~pLine --v1
    | ...
  
  v1ParamValue = (~(space | frameV1 | sepRight | nl) any)+
  v1ParamListInline = v1ParamValue (sepLeftInline v1ParamValue)*

  v1Inline = 
    | frameV1 wi 
        v2Type wi 
          sepRight wi 
        v1ParamListInline wi 
          sepRight 
        v1PayloadInline 
      frameV1 --fp
    | frameV1 wi 
        v2Type wi 
          sepRight 
        v1PayloadInline 
      frameV1 --p

  v1PayloadInline = (~frameV1 any)*
  
  v1End = 
    | frameV1 --explicit
    | end --implicit

  v1Block = 
    | frameV1 wi 
         v2Type wi
         sepRight wi
         v1ParamListInline wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       frameV1 --fp
    | frameV1 wi 
         v2Type wi
         (sepRight wi)?
         nl 
         v1PayloadBlock
       frameV1 --p

  v1PayloadBlock = document
}

Ranki  {
  document (Sections need to be separated by two new lines)
    = sw<nl>* nonemptyListOf<section, nl2> sw<nl>*
  
  space := " " | "\t"
  nl = "\n" | "\r"
  c = ","
  s = ";"
  a = "="
  dir = "%%%"
  fr = ":::"
  qd = "\""
  qs = "'"
  neg = "!"
  char = ~"\"" ~"\n" any
  
  nl2 = nl spaces nl
  wr<wrapper, elem> = wrapper elem wrapper 
  sw<elem> = wr<spaces, elem>
  sep<char, ln>
    = sw<char?> ln spaces --multiline
    | sw<char> --singleline

  paramValueItem
    = qd (~(qd) any)* qd --literalDoubleQuote
    | qs (~(qs) any)* qs --literalSingleQuote
    | frame_inline --frameInline
    | frame_empty --frameEmpty
    | digit+ -- number
    | letter+ --word

  paramValue = nonemptyListOf<paramValueItem, spaces>
  param
    = paramKeyword wr<spaces, a> paramValue --assignment
    | neg paramKeyword --negative
    | paramKeyword --positive
  paramKeyword = lower+
  params = listOf<param, sep<c, nl>> sep<c,nl>?
  
  section = directive | block
  
  directiveContent = document
  directive = dir sw<nl?> params sep<s, nl> directiveContent sw<nl?> dir
  
  block = frame_block  | paragraph
  
  frameType = nonemptyListOf<letter+, space>
  frameInlineContent = line
  frameBlockContent = document
  frameParams = params
  frameAttributes = params
  frameSpecs 
    = fr sw<frameType> sep<c, nl> frameAttributes sep<s, nl> frameParams sep<s, nl> --ap
    | fr sw<frameType> sep<c, nl> frameAttributes sep<s, nl> --a
    | fr sw<frameType> sep<s, nl> frameParams sep<s, nl> --p
    | fr sw<frameType> sep<s, nl> --n
    | fr wr<space?, frameType> --e
    
  frame
    = frameSpecs frameInlineContent sw<nl?> fr --inline
    | frameSpecs frameBlockContent sw<nl?> fr--block
    | frameSpecs fr --empty
 
  paragraph = nonemptyListOf<line, nl> nl?
  line = nonemptyListOf<lineContent, spaces> spaces
  lineContent = frame_inline | frame_empty | lineWord
  lineWord = lineChar+
  lineChar = ~(fr | dir | space | nl) any
}
